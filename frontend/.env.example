# Frontend env — Vite only exposes variables prefixed with VITE_.
# Sentry (SaaS): set the project DSN to activate error+performance tracking.
VITE_SENTRY_DSN=""
VITE_SENTRY_ENV="development"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Sentry release/source-map upload (production builds only). Leave AUTH_TOKEN
# empty to disable source-map upload entirely.
VITE_SENTRY_ORG=""
VITE_SENTRY_PROJECT=""
VITE_SENTRY_AUTH_TOKEN=""