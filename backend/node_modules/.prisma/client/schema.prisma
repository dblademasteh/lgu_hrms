generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  role         Role
  departmentId String?
  externalId   String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(6)
  department   Department? @relation(fields: [departmentId], references: [id])
  auditLogs    AuditLog[]
}

model Department {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  parentId  String?
  level     Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  users     User[]
  employees Employee[]
  parent    Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")
}

model Position {
  id          String     @id @default(uuid())
  title       String
  salaryGrade Int
  step        Int?
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  employees   Employee[]
}

model Employee {
  id                String              @id @default(uuid())
  employeeNumber    String              @unique
  firstName         String
  lastName          String
  middleName        String?
  birthDate         DateTime            @db.Date
  gender            String
  civilStatus       String
  address           String
  contactNumber     String?
  email             String?
  status            EmploymentStatus    @default(ACTIVE)
  departmentId      String
  positionId        String
  hiredDate         DateTime            @db.Date
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  department        Department          @relation(fields: [departmentId], references: [id])
  position          Position            @relation(fields: [positionId], references: [id])
  employmentHistory EmploymentHistory[]
  payrollItems      PayrollItem[]
}

model EmploymentHistory {
  id           String    @id @default(uuid())
  employeeId   String
  departmentId String
  positionId   String
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  employee     Employee  @relation(fields: [employeeId], references: [id])
}

model PayrollPeriod {
  id         String       @id @default(uuid())
  name       String
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date
  fiscalYear Int
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  runs       PayrollRun[]
}

model PayrollRun {
  id            String        @id @default(uuid())
  periodId      String
  runDate       DateTime      @db.Date
  status        PayrollStatus @default(DRAFT)
  createdBy     String
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  period        PayrollPeriod @relation(fields: [periodId], references: [id])
  items         PayrollItem[]
  ledgerEntries LedgerEntry[]
}

model PayrollItem {
  id         String     @id @default(uuid())
  employeeId String
  runId      String
  basicPay   Decimal    @db.Decimal(12, 2)
  allowances Decimal    @db.Decimal(12, 2)
  deductions Decimal    @db.Decimal(12, 2)
  netPay     Decimal    @db.Decimal(12, 2)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  employee   Employee   @relation(fields: [employeeId], references: [id])
  run        PayrollRun @relation(fields: [runId], references: [id])
}

model LedgerEntry {
  id         String     @id @default(uuid())
  runId      String
  employeeId String
  type       LedgerType
  amount     Decimal    @db.Decimal(12, 2)
  balance    Decimal    @db.Decimal(12, 2)
  reference  String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  run        PayrollRun @relation(fields: [runId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  HR_MANAGER
  PAYROLL_OFFICER
  DEPARTMENT_HEAD
  AUDITOR
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  RETIRED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  POSTED
}

enum LedgerType {
  PAY
  DEDUCTION
  ADJUSTMENT
}
