generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Multi-tenancy (shared-schema + tenantId) ─────────────────────────────
// Every LGU is a Tenant. All business tables carry tenantId; every query is
// scoped by tenantScope(req) in repositories. Cross-tenant access fails
// closed unless the user is a SUPER_ADMIN (platform operator).
model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  domain    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  users       User[]
  departments Department[]
  positions   Position[]
  employees   Employee[]
  familyMembers FamilyMember[]
  educationRecords EducationRecord[]
  awards     Award[]
  employmentHistory EmploymentHistory[]
  payrollPeriods PayrollPeriod[]
  payrollRuns PayrollRun[]
  payrollItems PayrollItem[]
  payrollDeductionLines PayrollDeductionLine[]
  payslips   Payslip[]
  ledgerEntries LedgerEntry[]
  auditLogs  AuditLog[]
  userSessions UserSession[]
  loginEvents LoginEvent[]
  delegations Delegation[]
  leaveRequests LeaveRequest[]
  leaveCredits LeaveCredit[]
  attendances Attendance[]
  appointments Appointment[]
  performanceReviews PerformanceReview[]
  plantillaItems PlantillaItem[]
  vacancyPublications VacancyPublication[]
  designationOrders DesignationOrder[]
  trainingPrograms TrainingProgram[]
  trainingEnrollments TrainingEnrollment[]
  eligibilities Eligibility[]
  disqualifications Disqualification[]
  applicants Applicant[]
  interviews Interview[]
  contributionRules ContributionRule[]
  taxBrackets TaxBracket[]
  leaveRuleConfigs LeaveRuleConfig[]
  bonuses Bonus[]
  idps IDP[]
  competencies Competency[]
  loans Loan[]
  loanAmortizations LoanAmortization[]
  attendanceRules AttendanceRule[]
  vacancies   Vacancy[]
}

model User {
  id               String    @id @default(uuid())
  tenantId         String?
  username         String    @unique
  passwordHash     String
  pinHash          String?
  role             Role
  departmentId     String?
  externalId       String?
  displayName      String?
  email            String?
  contactNumber    String?
  emergencyContact String?
  passwordChangedAt DateTime? @db.Timestamptz(6)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  displayPrefs     Json?
  avatarPath       String?
  signaturePath    String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  department       Department? @relation(fields: [departmentId], references: [id])
  linkedEmployee   Employee?   @relation("UserEmployeeLink", fields: [externalId], references: [employeeNumber])
  tenant           Tenant?     @relation(fields: [tenantId], references: [id])
  auditLogs        AuditLog[]
  sessions         UserSession[]
  loginEvents      LoginEvent[]
  delegationsFrom  Delegation[] @relation("delegator")
  delegationsTo    Delegation[] @relation("delegatee")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String?
  code      String   @unique
  name      String
  parentId  String?
  level     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  users     User[]
  employees Employee[]
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  parent    Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")
  plantillaItems PlantillaItem[]
  applicants Applicant[]
}

model Position {
  id          String   @id @default(uuid())
  tenantId    String?
  title       String
  salaryGrade Int
  step        Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  employees   Employee[]
  plantillaItems PlantillaItem[]
  applicants  Applicant[]
}

model Employee {
  id               String   @id @default(uuid())
  tenantId         String?
  employeeNumber   String   @unique
  firstName        String
  lastName         String
  middleName       String?
  birthDate        DateTime @db.Date
  gender           String
  civilStatus      String
  address          String
  contactNumber    String?
  email            String?
  status           EmploymentStatus @default(ACTIVE)
  departmentId     String
  positionId       String
  hiredDate        DateTime @db.Date
  deletedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  department       Department @relation(fields: [departmentId], references: [id])
  position         Position @relation(fields: [positionId], references: [id])
  employmentHistory EmploymentHistory[]
  payrollItems     PayrollItem[]
  leaveRequests    LeaveRequest[]
  leaveCredits     LeaveCredit[]
  attendances      Attendance[]
  appointments     Appointment[]
  performanceReviews PerformanceReview[]
  designationOrders DesignationOrder[]
  trainingEnrollments TrainingEnrollment[]
  eligibilities    Eligibility[]
  bonuses          Bonus[]
  loans            Loan[]
  idps             IDP[]
  familyMembers    FamilyMember[]
  educationRecords EducationRecord[]
  awards           Award[]
  linkedUsers      User[] @relation("UserEmployeeLink")
  disqualifications Disqualification[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model FamilyMember {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  relationship String
  firstName   String
  lastName    String
  middleName  String?
  birthDate   DateTime? @db.Date
  occupation  String?
  isDependent Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model EducationRecord {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  level       String
  school      String
  degree      String?
  fromDate    DateTime? @db.Date
  toDate      DateTime? @db.Date
  unitsEarned Float?
  yearGraduated Int?
  scholarships String?
  honors      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Award {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  title       String
  issuer      String?
  dateGiven   DateTime? @db.Date
  remarks     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model EmploymentHistory {
  id         String   @id @default(uuid())
  tenantId    String?
  employeeId String
  departmentId String
  positionId String
  startDate  DateTime @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model PayrollPeriod {
  id        String   @id @default(uuid())
  tenantId    String?
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  fiscalYear Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  runs      PayrollRun[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model PayrollRun {
  id          String   @id @default(uuid())
  tenantId    String?
  periodId    String
  runDate     DateTime @db.Date
  status      PayrollStatus @default(DRAFT)
  createdBy   String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  period      PayrollPeriod @relation(fields: [periodId], references: [id])
  items       PayrollItem[]
  ledgerEntries LedgerEntry[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model PayrollItem {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  runId       String
  basicPay    Decimal  @db.Decimal(12,2)
  allowances  Decimal  @db.Decimal(12,2)
  deductions  Decimal  @db.Decimal(12,2)
  netPay      Decimal  @db.Decimal(12,2)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  run         PayrollRun @relation(fields: [runId], references: [id])
  deductionLines PayrollDeductionLine[]
  payslip Payslip?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model PayrollDeductionLine {
  id          String   @id @default(uuid())
  tenantId    String?
  payrollItemId String
  code        String
  description String?
  employeeShare Decimal @db.Decimal(12,2) @default(0)
  employerShare Decimal @db.Decimal(12,2) @default(0)
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Payslip {
  id          String   @id @default(uuid())
  tenantId    String?
  payrollItemId String @unique
  generatedAt DateTime @default(now()) @db.Timestamptz(6)
  pdfUrl      String?
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LedgerEntry {
  id        String   @id @default(uuid())
  tenantId    String?
  runId     String
  employeeId String
  type      LedgerType
  amount    Decimal  @db.Decimal(12,2)
  balance   Decimal  @db.Decimal(12,2)
  reference String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  run       PayrollRun @relation(fields: [runId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId    String?
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  user      User @relation(fields: [userId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model UserSession {
  id         String    @id @default(uuid())
  tenantId    String?
  userId     String
  deviceHash String
  ip         String?
  userAgent  String?
  lastActive DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LoginEvent {
  id        String   @id @default(uuid())
  tenantId    String?
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Delegation {
  id         String   @id @default(uuid())
  tenantId    String?
  delegatorId String
  delegateeId String
  scope      String?
  reason     String?
  startsAt   DateTime @db.Timestamptz(6)
  endsAt     DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  delegator  User     @relation("delegator", fields: [delegatorId], references: [id])
  delegatee  User     @relation("delegatee", fields: [delegateeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LeaveRequest {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  type        LeaveType
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  days        Float
  status      LeaveStatus @default(PENDING)
  reason      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LeaveCredit {
  id         String   @id @default(uuid())
  tenantId    String?
  employeeId String
  type       LeaveType
  balance    Float    @default(0)
  year       Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Attendance {
  id         String   @id @default(uuid())
  tenantId    String?
  employeeId String
  date       DateTime @db.Date
  timeIn     DateTime? @db.Timestamptz(6)
  timeOut    DateTime? @db.Timestamptz(6)
  hours      Float?
  remark     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Appointment {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  type        AppointmentType
  itemNumber  String
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  status      String @default("ACTIVE")
  position    String?
  dept        String?
  name        String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  designationOrders DesignationOrder[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model PerformanceReview {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  reviewYear  Int
  reviewType  String
  rating      Float?
  comments    String?
  status      ReviewStatus @default(DRAFT)
  reviewedBy  String?
  reviewedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model PlantillaItem {
  id           String          @id @default(uuid())
  tenantId    String?
  itemNumber   String          @unique
  positionId   String
  departmentId String
  status       PlantillaStatus @default(VACANT)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  position     Position        @relation(fields: [positionId], references: [id])
  department   Department      @relation(fields: [departmentId], references: [id])
  vacancies    Vacancy[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Vacancy {
  id              String        @id @default(uuid())
  tenantId        String?
  plantillaItemId String
  title           String
  description     String?
  qualifications  String?
  status          VacancyStatus @default(OPEN)
  publishedAt     DateTime?     @db.Timestamptz(6)
  closesAt        DateTime?     @db.Date
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  plantillaItem   PlantillaItem @relation(fields: [plantillaItemId], references: [id])
  publications     VacancyPublication[]
  designationOrders DesignationOrder[]
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])
}

model VacancyPublication {
  id           String   @id @default(uuid())
  tenantId    String?
  vacancyId    String
  channel      String
  publishedAt  DateTime @default(now()) @db.Timestamptz(6)
  link         String?
  vacancy      Vacancy  @relation(fields: [vacancyId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model DesignationOrder {
  id            String   @id @default(uuid())
  tenantId    String?
  employeeId    String
  appointmentId String?
  vacancyId     String?
  orderNumber   String   @unique
  issuedDate    DateTime @db.Date
  signedBy      String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  employee      Employee @relation(fields: [employeeId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  vacancy       Vacancy? @relation(fields: [vacancyId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model TrainingProgram {
  id           String   @id @default(uuid())
  tenantId    String?
  code         String   @unique
  title        String
  description  String?
  durationHours Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  enrollments  TrainingEnrollment[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model TrainingEnrollment {
  id         String   @id @default(uuid())
  tenantId    String?
  employeeId String
  programId  String
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
  program    TrainingProgram @relation(fields: [programId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Eligibility {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  eligibilityType String
  rating      String?
  examDate    DateTime? @db.Date
  validUntil  DateTime? @db.Date
  remarks     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

// DIBAR - Disqualified, Barred, or Disqualified Individuals
enum DisqualificationType {
  VIOLATION_OF_CSC_RULES
  CRIMINAL_CONVICTION
  MORAL_TURPITUDE
  FRAUD
  MISCONDUCT
  OTHER
}

enum DisqualificationReason {
  GROSS_MISCONDUCT
  HARRASSMENT
  EMBEZZLEMENT
  FRAUDULENT_MISREPRESENTATION
  SUBSTANCE_ABUSE
  POLITICAL_PARTISANISM
  OTHER_GROUNDS
}

model Disqualification {
  id                    String           @id @default(uuid())
  tenantId    String?
  employeeId            String
  type                  DisqualificationType
  reason                DisqualificationReason
  date                  DateTime         @db.Date
  validity              DateTime?        @db.Date
  remarks               String?
  evidenceDocument      String?          // URL or path to supporting document
  isBarred              Boolean          @default(false)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  createdBy             String?
  employee              Employee         @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Applicant {
  id            String   @id @default(uuid())
  tenantId    String?
  firstName     String
  lastName      String
  middleName    String?
  email         String?
  phone         String?
  status        ApplicantStatus @default(APPLIED)
  appliedPositionId String?
  appliedDepartmentId String?
  resumeUrl     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  position      Position? @relation(fields: [appliedPositionId], references: [id])
  department    Department? @relation(fields: [appliedDepartmentId], references: [id])
  interviews    Interview[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model ContributionRule {
  id          String   @id @default(uuid())
  tenantId    String?
  type        String
  employeeRate Decimal @db.Decimal(5,4)
  employerRate Decimal @db.Decimal(5,4)
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model TaxBracket {
  id          String   @id @default(uuid())
  tenantId    String?
  minIncome   Decimal @db.Decimal(12,2)
  maxIncome   Decimal? @db.Decimal(12,2)
  rate        Decimal @db.Decimal(5,4)
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LeaveRuleConfig {
  id          String   @id @default(uuid())
  tenantId    String?
  leaveType   LeaveType
  accrualPerMonth Decimal @db.Decimal(4,2)
  maxCarryOver Decimal? @db.Decimal(6,2)
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

enum BonusType {
  THIRTEENTH_MONTH
  CASH_GIFT
  YEAR_END_BONUS
}

model Bonus {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  type        BonusType
  amount      Decimal @db.Decimal(12,2)
  periodYear  Int
  periodMonth Int?
  status      String @default("PENDING")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

enum ApplicantStatus {
  APPLIED
  SCREENED
  SHORTLISTED
  INTERVIEWED
  OFFERED
  HIRED
  REJECTED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  CANCELLED
}

enum PlantillaStatus {
  VACANT
  FILLED
  FROZEN
}

enum VacancyStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  PAYROLL_OFFICER
  DEPARTMENT_HEAD
  AUDITOR
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  RETIRED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  POSTED
}

enum LedgerType {
  PAY
  DEDUCTION
  ADJUSTMENT
}

enum LeaveType {
  VACATION
  SICK
  SPECIAL_PRIVILEGE
  MATERNITY
  PATERNITY
  SOLO_PARENT
  SPECIAL_WOMEN
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum AppointmentType {
  PERMANENT
  TEMPORARY
  CASUAL
  CONTRACTUAL
  JOB_ORDER
  COS
  COTERMINOUS
}

enum LoanType {
  SALARY_ADVANCE
  CASH_LOAN
  HOUSING_LOAN
  EDUCATION_LOAN
}

enum LoanStatus {
  PENDING
  APPROVED
  DISBURSED
  PAID
  CANCELLED
}

model Loan {
  id          String    @id @default(uuid())
  tenantId    String?
  employeeId  String
  type        LoanType
  amount      Decimal   @db.Decimal(12,2)
  termMonths  Int
  startDate   DateTime  @db.Date
  status      LoanStatus @default(PENDING)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  employee    Employee  @relation(fields: [employeeId], references: [id])
  amortizations LoanAmortization[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LoanAmortization {
  id        String   @id @default(uuid())
  tenantId    String?
  loanId    String
  dueDate   DateTime @db.Date
  amount    Decimal  @db.Decimal(12,2)
  paid      Boolean  @default(false)
  loan      Loan     @relation(fields: [loanId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model AttendanceRule {
  id            String  @id @default(uuid())
  tenantId    String?
  name          String
  tardinessMin  Int
  deductionRate Decimal @db.Decimal(12,2)
  active        Boolean @default(true)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Competency {
  id          String @id @default(uuid())
  tenantId    String?
  code        String @unique
  name        String
  description String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model IDP {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  year        Int
  goals       Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Interview {
  id          String   @id @default(uuid())
  tenantId    String?
  applicantId String
  scheduledAt DateTime @db.Timestamptz(6)
  status      String   @default("SCHEDULED")
  notes       String?
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

