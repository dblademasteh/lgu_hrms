model Loan {
  id          String    @id @default(uuid())
  tenantId    String?
  employeeId  String
  type        LoanType
  amount      Decimal   @db.Decimal(12,2)
  termMonths  Int
  startDate   DateTime  @db.Date
  status      LoanStatus @default(PENDING)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  employee    Employee  @relation(fields: [employeeId], references: [id])
  amortizations LoanAmortization[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

model LoanAmortization {
  id        String   @id @default(uuid())
  tenantId    String?
  loanId    String
  dueDate   DateTime @db.Date
  amount    Decimal  @db.Decimal(12,2)
  paid      Boolean  @default(false)
  loan      Loan     @relation(fields: [loanId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, paid, dueDate])
}

model AttendanceRule {
  id            String  @id @default(uuid())
  tenantId    String?
  name          String
  tardinessMin  Int
  deductionRate Decimal @db.Decimal(12,2)
  active        Boolean @default(true)
  // Daily schedule (minutes since Manila midnight). Defaults: 08:00-17:00
  // with a 12:00-13:00 unpaid lunch.
  workStartMins Int @default(480)
  workEndMins   Int @default(1020)
  lunchStartMins Int @default(720)
  lunchEndMins   Int @default(780)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, active])
}

model BiometricCredential {
  id            String   @id @default(uuid())
  tenantId       String?
  employeeId     String
  credentialId   String   @unique
  publicKey      String
  counter        Int      @default(0)
  deviceName     String?
  enrolledAt     DateTime @default(now()) @db.Timestamptz(6)
  lastUsedAt     DateTime? @db.Timestamptz(6)
  employee       Employee @relation(fields: [employeeId], references: [id])
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
}

model Competency {
  id          String @id @default(uuid())
  tenantId    String?
  code        String @unique
  name        String
  description String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  reviewItems PerformanceCompetency[]
}

model PerformanceCompetency {
  id         String   @id @default(uuid())
  tenantId   String?
  reviewId   String
  competencyId String
  score      Float
  maxScore   Float
  comments   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  review     PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id])
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])

  @@unique([reviewId, competencyId])
}

model IDP {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  year        Int
  goals       Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Interview {
  id          String   @id @default(uuid())
  tenantId    String?
  applicantId String
  scheduledAt DateTime @db.Timestamptz(6)
  status      InterviewStatus @default(SCHEDULED)
  notes       String?
  applicant   Applicant @relation(fields: [applicantId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model ApiKey {
  id        String   @id @default(uuid())
  tenantId  String?
  name      String
  keyHash   String   @unique
  scopes    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String?
  name      String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
}

model ExternalSystem {
  id            String    @id @default(uuid())
  tenantId      String?
  name          String
  type          String
  description   String?
  baseUrl       String
  apiKey        String?
  apiSecret     String?
  headers       String?
  syncDirection String    @default("pull")
  isActive      Boolean   @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model SyncRequest {
  id          String   @id @default(uuid())
  tenantId    String
  source      String   @default("IMS")
  target      String   @default("HRMS")
  imsApiKey   String?
  datasets    String[]
  status      String   @default("PENDING")
  requestedBy String
  approvedBy  String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  notes       String?
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}


