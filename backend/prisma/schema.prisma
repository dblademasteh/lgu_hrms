generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                       String                    @id @default(uuid())
  code                     String                    @unique
  name                     String
  domain                   String?                   @unique
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  lguLevel                 LguLevel                  @default(PROVINCIAL)
  allowedIps               String[]                  @default([])
  allowanceRules           AllowanceRule[]
  apiKeys                  ApiKey[]
  applicants               Applicant[]
  appointments             Appointment[]
  attendances              Attendance[]
  attendanceRules          AttendanceRule[]
  auditLogs                AuditLog[]
  awards                   Award[]
  biometricCredentials     BiometricCredential[]
  biometricDevices         BiometricDevice[]
  bonuses                  Bonus[]
  competencies             Competency[]
  contributionRules        ContributionRule[]
  delegations              Delegation[]
  departments              Department[]
  designationOrders        DesignationOrder[]
  disqualifications        Disqualification[]
  documentAccessLogs       DocumentAccessLog[]
  documents                Document[]
  educationRecords         EducationRecord[]
  eligibilities            Eligibility[]
  employees                Employee[]
  employmentHistory        EmploymentHistory[]
  externalSystems          ExternalSystem[]
  familyMembers            FamilyMember[]
  idps                     IDP[]
  interviews               Interview[]
  ldPlans                  LdPlan[]
  leaveCredits             LeaveCredit[]
  leaveRequests            LeaveRequest[]
  leaveRuleConfigs         LeaveRuleConfig[]
  ledgerEntries            LedgerEntry[]
  loans                    Loan[]
  loanAmortizations        LoanAmortization[]
  loginEvents              LoginEvent[]
  msbMinutes               MSBMinutes[]
  overtimeRequests         OvertimeRequest[]
  payrollDeductionLines    PayrollDeductionLine[]
  payrollItems             PayrollItem[]
  payrollPeriods           PayrollPeriod[]
  payrollRuns              PayrollRun[]
  payslips                 Payslip[]
  performanceCompetencies  PerformanceCompetency[]
  performanceReviews       PerformanceReview[]
  plantillaItems           PlantillaItem[]
  positions                Position[]
  roles                    Role[]
  rolePermissions          RolePermission[]
  stepIncrementRules       StepIncrementRule[]
  syncRequests             SyncRequest[]
  taxBrackets              TaxBracket[]
  trainingEnrollments      TrainingEnrollment[]
  trainingEvaluations      TrainingEvaluation[]
  trainingNeedsAssessments TrainingNeedsAssessment[]
  trainingPrograms         TrainingProgram[]
  users                    User[]
  userSessions             UserSession[]
  vacancies                Vacancy[]
  vacancyPublications      VacancyPublication[]
  webhooks                 WebhookSubscription[]
}

model User {
  id                String        @id @default(uuid())
  username          String        @unique
  passwordHash      String
  departmentId      String?
  externalId        String?
  passwordChangedAt DateTime?     @db.Timestamptz(6)
  twoFactorEnabled  Boolean       @default(false)
  twoFactorSecret   String?
  displayPrefs      Json?
  avatarPath        String?
  signaturePath     String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  contactNumber     String?
  displayName       String?
  email             String?
  emergencyContact  String?
  status            String        @default("ACTIVE")
  pinHash           String?
  tenantId          String?
  idpProvider       String?
  role              String
  auditLogs         AuditLog[]
  delegationsTo     Delegation[]  @relation("delegatee")
  delegationsFrom   Delegation[]  @relation("delegator")
  loginEvents       LoginEvent[]
  department        Department?   @relation(fields: [departmentId], references: [id])
  linkedEmployee    Employee?     @relation("UserEmployeeLink", fields: [externalId], references: [employeeNumber])
  tenant            Tenant?       @relation(fields: [tenantId], references: [id])
  sessions          UserSession[]
}

model Department {
  id                    String             @id @default(uuid())
  code                  String             @unique
  name                  String
  parentId              String?
  level                 Int                @default(0)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  tenantId              String?
  unitType              DepartmentUnitType @default(DEPARTMENT)
  isMandatory           Boolean            @default(false)
  isOptional            Boolean            @default(false)
  isHrmOffice           Boolean            @default(false)
  headTitle             String?
  sanggunianConcurrence Boolean            @default(false)
  concurrenceDate       DateTime?          @db.Date
  concurrenceResolution String?
  cscSubmissionDate     DateTime?          @db.Date
  remarks               String?
  lguOfficeCategory     LguOfficeCategory?
  applicants            Applicant[]
  parent                Department?        @relation("DeptHierarchy", fields: [parentId], references: [id])
  children              Department[]       @relation("DeptHierarchy")
  tenant                Tenant?            @relation(fields: [tenantId], references: [id])
  employees             Employee[]
  plantillaItems        PlantillaItem[]
  users                 User[]
}

model Position {
  id                     String          @id @default(uuid())
  title                  String
  salaryGrade            Int
  step                   Int?
  createdAt              DateTime        @default(now()) @db.Timestamptz(6)
  tenantId               String?
  parentheticalTitle     String?
  iosLguCode             String?
  isMandatory            Boolean         @default(false)
  isCoterminous          Boolean         @default(false)
  qualificationStandards String?
  applicants             Applicant[]
  employees              Employee[]
  plantillaItems         PlantillaItem[]
  tenant                 Tenant?         @relation(fields: [tenantId], references: [id])
}

model StepIncrementRule {
  id              String    @id @default(uuid())
  tenantId        String?
  salaryGrade     Int
  fromStep        Int
  toStep          Int
  incrementAmount Decimal   @db.Decimal(12, 2)
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, salaryGrade])
}

model Employee {
  id                       String                    @id @default(uuid())
  employeeNumber           String                    @unique
  firstName                String
  lastName                 String
  middleName               String?
  birthDate                DateTime                  @db.Date
  gender                   String
  civilStatus              String
  address                  String
  contactNumber            String?
  email                    String?
  status                   EmploymentStatus          @default(ACTIVE)
  departmentId             String
  positionId               String
  hiredDate                DateTime                  @db.Date
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  deletedAt                DateTime?                 @db.Timestamptz(6)
  tenantId                 String?
  monthlySalary            Decimal                   @default(0) @db.Decimal(12, 2)
  keyPosition              String?
  sssNumber                String?
  philhealthNumber         String?
  pagibigNumber            String?
  tinNumber                String?
  bankAccount              String?
  bankName                 String?
  appointments             Appointment[]
  attendances              Attendance[]
  awards                   Award[]
  biometricCredentials     BiometricCredential[]
  biometricDeviceUsers     BiometricDeviceUser[]
  bonuses                  Bonus[]
  designationOrders        DesignationOrder[]
  disqualifications        Disqualification[]
  documents                Document[]
  educationRecords         EducationRecord[]
  eligibilities            Eligibility[]
  department               Department                @relation(fields: [departmentId], references: [id])
  position                 Position                  @relation(fields: [positionId], references: [id])
  tenant                   Tenant?                   @relation(fields: [tenantId], references: [id])
  employmentHistory        EmploymentHistory[]
  familyMembers            FamilyMember[]
  idps                     IDP[]
  leaveCredits             LeaveCredit[]
  leaveRequests            LeaveRequest[]
  loans                    Loan[]
  overtimeRequests         OvertimeRequest[]
  payrollItems             PayrollItem[]
  performanceReviews       PerformanceReview[]
  trainingEnrollments      TrainingEnrollment[]
  trainingNeedsAssessments TrainingNeedsAssessment[]
  linkedUsers              User[]                    @relation("UserEmployeeLink")

  @@index([tenantId])
  @@index([tenantId, status])
}

model FamilyMember {
  id           String    @id @default(uuid())
  employeeId   String
  relationship String
  firstName    String
  lastName     String
  middleName   String?
  birthDate    DateTime? @db.Date
  occupation   String?
  isDependent  Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  tenantId     String?
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
}

model EducationRecord {
  id            String    @id @default(uuid())
  employeeId    String
  level         String
  school        String
  degree        String?
  fromDate      DateTime? @db.Date
  toDate        DateTime? @db.Date
  unitsEarned   Float?
  yearGraduated Int?
  scholarships  String?
  honors        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  tenantId      String?
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
}

model Award {
  id         String    @id @default(uuid())
  employeeId String
  title      String
  issuer     String?
  dateGiven  DateTime? @db.Date
  remarks    String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  tenantId   String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
}

model EmploymentHistory {
  id           String    @id @default(uuid())
  employeeId   String
  departmentId String
  positionId   String
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  tenantId     String?
  employee     Employee  @relation(fields: [employeeId], references: [id])
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
}

model PayrollPeriod {
  id         String              @id @default(uuid())
  name       String
  startDate  DateTime            @db.Date
  endDate    DateTime            @db.Date
  fiscalYear Int
  createdAt  DateTime            @default(now()) @db.Timestamptz(6)
  tenantId   String?
  status     PayrollPeriodStatus @default(OPEN)
  tenant     Tenant?             @relation(fields: [tenantId], references: [id])
  runs       PayrollRun[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PayrollRun {
  id            String        @id @default(uuid())
  periodId      String
  runDate       DateTime      @db.Date
  status        PayrollStatus @default(DRAFT)
  createdBy     String
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  tenantId      String?
  generatedAt   DateTime?
  postedAt      DateTime?
  ledgerEntries LedgerEntry[]
  items         PayrollItem[]
  period        PayrollPeriod @relation(fields: [periodId], references: [id])
  tenant        Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([tenantId, periodId])
  @@index([tenantId, createdAt])
}

model PayrollItem {
  id             String                 @id @default(uuid())
  employeeId     String
  runId          String
  basicPay       Decimal                @db.Decimal(12, 2)
  allowances     Decimal                @db.Decimal(12, 2)
  deductions     Decimal                @db.Decimal(12, 2)
  netPay         Decimal                @db.Decimal(12, 2)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  tenantId       String?
  deductionLines PayrollDeductionLine[]
  employee       Employee               @relation(fields: [employeeId], references: [id])
  run            PayrollRun             @relation(fields: [runId], references: [id])
  tenant         Tenant?                @relation(fields: [tenantId], references: [id])
  payslip        Payslip?

  @@index([tenantId, runId])
}

model PayrollDeductionLine {
  id            String      @id @default(uuid())
  payrollItemId String
  code          String
  description   String?
  employeeShare Decimal     @default(0) @db.Decimal(12, 2)
  employerShare Decimal     @default(0) @db.Decimal(12, 2)
  tenantId      String?
  quantity      Decimal?    @db.Decimal(8, 2)
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id])
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])

  @@index([tenantId, payrollItemId])
}

model Payslip {
  id            String      @id @default(uuid())
  payrollItemId String      @unique
  generatedAt   DateTime    @default(now()) @db.Timestamptz(6)
  pdfUrl        String?
  tenantId      String?
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id])
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])

  @@index([tenantId, payrollItemId])
}

model LedgerEntry {
  id         String     @id @default(uuid())
  runId      String
  employeeId String
  type       LedgerType
  amount     Decimal    @db.Decimal(12, 2)
  balance    Decimal    @db.Decimal(12, 2)
  reference  String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  tenantId   String?
  run        PayrollRun @relation(fields: [runId], references: [id])
  tenant     Tenant?    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, runId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId, timestamp])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  deviceHash String
  ip         String?
  userAgent  String?
  lastActive DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Delegation {
  id          String   @id @default(uuid())
  delegatorId String
  delegateeId String
  scope       String?
  reason      String?
  startsAt    DateTime @db.Timestamptz(6)
  endsAt      DateTime @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  tenantId    String?
  delegatee   User     @relation("delegatee", fields: [delegateeId], references: [id])
  delegator   User     @relation("delegator", fields: [delegatorId], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String
  type            LeaveType
  fromDate        DateTime    @db.Date
  toDate          DateTime    @db.Date
  days            Float
  status          LeaveStatus @default(PENDING)
  reason          String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)
  tenantId        String?
  approvedAt      DateTime?   @db.Timestamptz(6)
  approvedBy      String?
  decisionNote    String?
  deniedAt        DateTime?   @db.Timestamptz(6)
  deniedBy        String?
  advanceNoticed  Boolean     @default(false)
  documentUrl     String?
  isForced        Boolean     @default(false)
  isHalfDay       Boolean     @default(false)
  isLwop          Boolean     @default(false)
  isTerminal      Boolean     @default(false)
  recommendedAt   DateTime?   @db.Timestamptz(6)
  recommendedBy   String?
  studyBondMonths Int?
  monetized       Boolean     @default(false)
  monetizedAmount Decimal?    @db.Decimal(12, 2)
  monetizedAt     DateTime?   @db.Timestamptz(6)
  monetizedDays   Float?
  employee        Employee    @relation(fields: [employeeId], references: [id])
  tenant          Tenant?     @relation(fields: [tenantId], references: [id])
}

model LeaveCredit {
  id         String    @id @default(uuid())
  employeeId String
  type       LeaveType
  balance    Float     @default(0)
  year       Int
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  tenantId   String?
  employee   Employee  @relation(fields: [employeeId], references: [id])
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, employeeId, type, year])
}

model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime  @db.Date
  timeIn     DateTime? @db.Timestamptz(6)
  timeOut    DateTime? @db.Timestamptz(6)
  hours      Float?
  remark     String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  tenantId   String?
  deviceRef  String?
  source     String?   @default("MANUAL")
  employee   Employee  @relation(fields: [employeeId], references: [id])
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, employeeId, date])
}

model BiometricDevice {
  id              String                @id @default(uuid())
  tenantId        String?
  name            String
  model           String?
  protocol        String                @default("ZK_TCP")
  host            String
  port            Int                   @default(4370)
  serial          String?
  active          Boolean               @default(true)
  pollIntervalMs  Int                   @default(30000)
  lastConnectedAt DateTime?             @db.Timestamptz(6)
  lastSyncAt      DateTime?             @db.Timestamptz(6)
  lastError       String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)
  tenant          Tenant?               @relation(fields: [tenantId], references: [id])
  logs            BiometricDeviceLog[]
  userMappings    BiometricDeviceUser[]

  @@index([tenantId, active])
}

model BiometricDeviceLog {
  id           String          @id @default(uuid())
  tenantId     String?
  deviceId     String
  deviceLogId  String
  userId       String
  punchedAt    DateTime        @db.Timestamptz(6)
  verification String?
  employeeId   String?
  applied      Boolean         @default(false)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  device       BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceLogId])
  @@index([tenantId, deviceId, punchedAt])
}

model BiometricDeviceUser {
  id           String          @id @default(uuid())
  tenantId     String?
  deviceId     String
  deviceUserId String          @db.VarChar(120)
  employeeId   String
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)
  device       BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceUserId])
  @@index([tenantId, deviceId])
  @@index([tenantId, employeeId])
}

model Appointment {
  id                String             @id @default(uuid())
  employeeId        String
  type              AppointmentType
  itemNumber        String
  startDate         DateTime           @db.Date
  endDate           DateTime?          @db.Date
  status            AppointmentStatus  @default(PENDING)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  dept              String?
  position          String?
  name              String?
  tenantId          String?
  deletedAt         DateTime?          @db.Timestamptz(6)
  plantillaItemId   String?
  signedBy          String?
  issuedBy          String?
  approvedBy        String?
  verifiedBy        String?
  documentUrl       String?
  oraohraReference  String?
  cscFormNo         String?
  remarks           String?
  employee          Employee           @relation(fields: [employeeId], references: [id])
  plantillaItem     PlantillaItem?     @relation(fields: [plantillaItemId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  designationOrders DesignationOrder[]
}

model PerformanceReview {
  id               String                  @id @default(uuid())
  employeeId       String
  reviewYear       Int
  reviewType       String
  rating           Decimal?                @db.Decimal(3, 2)
  comments         String?
  status           ReviewStatus            @default(PLANNING)
  reviewedBy       String?
  reviewedAt       DateTime?               @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(6)
  tenantId         String?
  adjectivalRating AdjectivalRating?
  approvedAt       DateTime?               @db.Timestamptz(6)
  approvedBy       String?
  competencyWeight Decimal                 @default(30) @db.Decimal(5, 2)
  coreWeight       Decimal                 @default(50) @db.Decimal(5, 2)
  officeRatingCap  Decimal?                @db.Decimal(3, 2)
  periodEnd        DateTime?               @db.Timestamptz(6)
  periodStart      DateTime?               @db.Timestamptz(6)
  planningDate     DateTime?               @db.Timestamptz(6)
  strategicWeight  Decimal                 @default(30) @db.Decimal(5, 2)
  supportWeight    Decimal                 @default(20) @db.Decimal(5, 2)
  parentReviewId   String?
  competencies     PerformanceCompetency[]
  employee         Employee                @relation(fields: [employeeId], references: [id])
  parentReview     PerformanceReview?      @relation("ReviewCascade", fields: [parentReviewId], references: [id])
  childReviews     PerformanceReview[]     @relation("ReviewCascade")
  tenant           Tenant?                 @relation(fields: [tenantId], references: [id])
  targets          PerformanceTarget[]

  @@index([tenantId, reviewYear, status])
  @@unique([tenantId, employeeId, reviewYear, reviewType])
}

model PerformanceTarget {
  id                  String            @id @default(uuid())
  tenantId            String?
  reviewId            String
  kra                 String
  successIndicator    String
  outputGroup         OutputGroup       @default(CORE)
  weight              Decimal           @db.Decimal(5, 2)
  targetQuantity      Decimal?          @db.Decimal(12, 2)
  targetUnit          String?
  q1Actual            String?
  q2Actual            String?
  q3Actual            String?
  q4Actual            String?
  annualActual        String?
  qualityScore        Decimal?          @db.Decimal(3, 2)
  efficiencyScore     Decimal?          @db.Decimal(3, 2)
  timelinessScore     Decimal?          @db.Decimal(3, 2)
  averageScore        Decimal?          @db.Decimal(3, 2)
  actualPercent       Decimal?          @db.Decimal(5, 2)
  meansOfVerification String?
  remarks             String?
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  review              PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([tenantId, reviewId])
}

model PlantillaItem {
  id                String            @id @default(uuid())
  itemNumber        String            @unique
  positionId        String
  departmentId      String
  status            PlantillaStatus   @default(VACANT)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  tenantId          String?
  itemType          PlantillaItemType @default(OLD_STYLE)
  salaryGrade       String?
  step              String?
  sourceOfFund      String?
  appropriationCode String?
  authorizedSalary  Decimal?          @db.Decimal(12, 2)
  isMandatory       Boolean           @default(false)
  isOptional        Boolean           @default(false)
  appointments      Appointment[]
  department        Department        @relation(fields: [departmentId], references: [id])
  position          Position          @relation(fields: [positionId], references: [id])
  tenant            Tenant?           @relation(fields: [tenantId], references: [id])
  vacancies         Vacancy[]
}

model Vacancy {
  id                      String               @id @default(uuid())
  plantillaItemId         String
  title                   String
  description             String?
  qualifications          String?
  status                  VacancyStatus        @default(DRAFT)
  publishedAt             DateTime?            @db.Timestamptz(6)
  closesAt                DateTime?            @db.Date
  createdAt               DateTime             @default(now()) @db.Timestamptz(6)
  tenantId                String?
  eligibilityRequirements String?
  screeningCriteria       String?
  approvedBy              String?
  publishedBy             String?
  applicants              Applicant[]
  designationOrders       DesignationOrder[]
