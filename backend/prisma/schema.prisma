generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Multi-tenancy (shared-schema + tenantId) ─────────────────────────────
// Every LGU is a Tenant. All business tables carry tenantId; every query is
// scoped by tenantScope(req) in repositories. Cross-tenant access fails
// closed unless the user is a SUPER_ADMIN (platform operator).
model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  domain    String?  @unique
  lguLevel  LguLevel @default(PROVINCIAL)
  isActive  Boolean  @default(true)
  // On-premise enforcement: source IP/CIDR allowlist for session-establishing
  // auth (login/login-pin/refresh). Empty = use global ALLOWED_IPS env;
  // both empty = no restriction.
  allowedIps String[]  @default([])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  users       User[]
  roles       Role[]
  rolePermissions RolePermission[]
  departments Department[]
  syncRequests SyncRequest[]
  positions   Position[]
  employees   Employee[]
  familyMembers FamilyMember[]
  educationRecords EducationRecord[]
  awards     Award[]
  employmentHistory EmploymentHistory[]
  payrollPeriods PayrollPeriod[]
  payrollRuns PayrollRun[]
  payrollItems PayrollItem[]
  payrollDeductionLines PayrollDeductionLine[]
  payslips   Payslip[]
  ledgerEntries LedgerEntry[]
  auditLogs  AuditLog[]
  userSessions UserSession[]
  loginEvents LoginEvent[]
  delegations Delegation[]
  leaveRequests LeaveRequest[]
  leaveCredits LeaveCredit[]
  attendances Attendance[]
  appointments Appointment[]
  performanceReviews PerformanceReview[]
  plantillaItems PlantillaItem[]
  vacancyPublications VacancyPublication[]
  designationOrders DesignationOrder[]
  trainingPrograms TrainingProgram[]
  trainingEnrollments TrainingEnrollment[]
  eligibilities Eligibility[]
  disqualifications Disqualification[]
  applicants Applicant[]
  interviews Interview[]
  contributionRules ContributionRule[]
  taxBrackets TaxBracket[]
  leaveRuleConfigs LeaveRuleConfig[]
  bonuses Bonus[]
  idps IDP[]
  competencies Competency[]
  loans Loan[]
  loanAmortizations LoanAmortization[]
  attendanceRules AttendanceRule[]
  biometricCredentials BiometricCredential[]
  vacancies   Vacancy[]
  performanceCompetencies PerformanceCompetency[]
  apiKeys ApiKey[]
  webhooks WebhookSubscription[]
  externalSystems ExternalSystem[]
  biometricDevices BiometricDevice[]
}

model User {
  id               String    @id @default(uuid())
  tenantId         String?
  username         String    @unique
  passwordHash     String
  pinHash          String?
  role             String
  departmentId     String?
  externalId       String?
  idpProvider      String?
  displayName      String?
  email            String?
  contactNumber    String?
  emergencyContact String?
  passwordChangedAt DateTime? @db.Timestamptz(6)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  displayPrefs     Json?
  avatarPath       String?
  signaturePath    String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  department       Department? @relation(fields: [departmentId], references: [id])
  linkedEmployee   Employee?   @relation("UserEmployeeLink", fields: [externalId], references: [employeeNumber])
  tenant           Tenant?     @relation(fields: [tenantId], references: [id])
  auditLogs        AuditLog[]
  sessions         UserSession[]
  loginEvents      LoginEvent[]
  delegationsFrom  Delegation[] @relation("delegator")
  delegationsTo    Delegation[] @relation("delegatee")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String?
  code      String   @unique
  name      String
  parentId  String?
  level     Int      @default(0)
  unitType  DepartmentUnitType @default(DEPARTMENT)
  lguOfficeCategory LguOfficeCategory?
  isMandatory Boolean @default(false)
  isOptional Boolean @default(false)
  isHrmOffice Boolean @default(false)
  headTitle String?
  sanggunianConcurrence Boolean @default(false)
  concurrenceDate DateTime? @db.Date
  concurrenceResolution String?
  cscSubmissionDate DateTime? @db.Date
  remarks String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  users     User[]
  employees Employee[]
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  parent    Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")
  plantillaItems PlantillaItem[]
  applicants Applicant[]
}

model Position {
  id          String   @id @default(uuid())
  tenantId    String?
  title       String
  parentheticalTitle String?
  iosLguCode  String?
  salaryGrade Int
  step        Int?
  isMandatory Boolean @default(false)
  isCoterminous Boolean @default(false)
  qualificationStandards String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  employees   Employee[]
  plantillaItems PlantillaItem[]
  applicants  Applicant[]
}

model Employee {
  id               String   @id @default(uuid())
  tenantId         String?
  employeeNumber   String   @unique
  firstName        String
  lastName         String
  middleName       String?
  birthDate        DateTime @db.Date
  gender           String
  civilStatus      String
  address          String
  contactNumber    String?
  email            String?
  status           EmploymentStatus @default(ACTIVE)
  monthlySalary    Decimal   @default(0) @db.Decimal(12,2)
  departmentId     String
  positionId       String
  hiredDate        DateTime @db.Date
  deletedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  department       Department @relation(fields: [departmentId], references: [id])
  position         Position @relation(fields: [positionId], references: [id])
  employmentHistory EmploymentHistory[]
  payrollItems     PayrollItem[]
  leaveRequests    LeaveRequest[]
  leaveCredits     LeaveCredit[]
  attendances      Attendance[]
  appointments     Appointment[]
  performanceReviews PerformanceReview[]
  designationOrders DesignationOrder[]
  trainingEnrollments TrainingEnrollment[]
  eligibilities    Eligibility[]
  bonuses          Bonus[]
  loans            Loan[]
  idps             IDP[]
  familyMembers    FamilyMember[]
  educationRecords EducationRecord[]
  awards           Award[]
  linkedUsers      User[] @relation("UserEmployeeLink")
  disqualifications Disqualification[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  biometricCredentials BiometricCredential[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model FamilyMember {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  relationship String
  firstName   String
  lastName    String
  middleName  String?
  birthDate   DateTime? @db.Date
  occupation  String?
  isDependent Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model EducationRecord {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  level       String
  school      String
  degree      String?
  fromDate    DateTime? @db.Date
  toDate      DateTime? @db.Date
  unitsEarned Float?
  yearGraduated Int?
  scholarships String?
  honors      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Award {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  title       String
  issuer      String?
  dateGiven   DateTime? @db.Date
  remarks     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model EmploymentHistory {
  id         String   @id @default(uuid())
  tenantId    String?
  employeeId String
  departmentId String
  positionId String
  startDate  DateTime @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model PayrollPeriod {
  id        String   @id @default(uuid())
  tenantId    String?
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  fiscalYear Int
  status    PayrollPeriodStatus @default(OPEN)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  runs      PayrollRun[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PayrollRun {
  id          String   @id @default(uuid())
  tenantId    String?
  periodId    String
  runDate     DateTime @db.Date
  status      PayrollStatus @default(DRAFT)
  createdBy   String
  generatedAt DateTime?
  postedAt    DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  period      PayrollPeriod @relation(fields: [periodId], references: [id])
  items       PayrollItem[]
  ledgerEntries LedgerEntry[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, periodId])
  @@index([tenantId, createdAt])
}

model PayrollItem {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  runId       String
  basicPay    Decimal  @db.Decimal(12,2)
  allowances  Decimal  @db.Decimal(12,2)
  deductions  Decimal  @db.Decimal(12,2)
  netPay      Decimal  @db.Decimal(12,2)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  run         PayrollRun @relation(fields: [runId], references: [id])
  deductionLines PayrollDeductionLine[]
  payslip Payslip?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, runId])
}

model PayrollDeductionLine {
  id          String   @id @default(uuid())
  tenantId    String?
  payrollItemId String
  code        String
  description String?
  employeeShare Decimal @db.Decimal(12,2) @default(0)
  employerShare Decimal @db.Decimal(12,2) @default(0)
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, payrollItemId])
}

model Payslip {
  id          String   @id @default(uuid())
  tenantId    String?
  payrollItemId String @unique
  generatedAt DateTime @default(now()) @db.Timestamptz(6)
  pdfUrl      String?
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, payrollItemId])
}

model LedgerEntry {
  id        String   @id @default(uuid())
  tenantId    String?
  runId     String
  employeeId String
  type      LedgerType
  amount    Decimal  @db.Decimal(12,2)
  balance   Decimal  @db.Decimal(12,2)
  reference String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  run       PayrollRun @relation(fields: [runId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, runId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId    String?
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  user      User @relation(fields: [userId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp])
}

model UserSession {
  id         String    @id @default(uuid())
  tenantId    String?
  userId     String
  deviceHash String
  ip         String?
  userAgent  String?
  lastActive DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LoginEvent {
  id        String   @id @default(uuid())
  tenantId    String?
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Delegation {
  id         String   @id @default(uuid())
  tenantId    String?
  delegatorId String
  delegateeId String
  scope      String?
  reason     String?
  startsAt   DateTime @db.Timestamptz(6)
  endsAt     DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  delegator  User     @relation("delegator", fields: [delegatorId], references: [id])
  delegatee  User     @relation("delegatee", fields: [delegateeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LeaveRequest {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  type        LeaveType
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  days        Float
  status      LeaveStatus @default(PENDING)
  reason      String?
  isHalfDay   Boolean  @default(false)
  isLwop      Boolean  @default(false)
  isTerminal  Boolean  @default(false)
  isForced    Boolean  @default(false)
  studyBondMonths Int?
  documentUrl String?
  advanceNoticed Boolean @default(false)
  monetized Boolean @default(false)
  monetizedAt DateTime? @db.Timestamptz(6)
  monetizedAmount Decimal? @db.Decimal(12,2)
  recommendedBy String?
  recommendedAt DateTime? @db.Timestamptz(6)
  approvedBy  String?
  approvedAt  DateTime? @db.Timestamptz(6)
  deniedBy    String?
  deniedAt    DateTime? @db.Timestamptz(6)
  decisionNote String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model LeaveCredit {
  id         String   @id @default(uuid())
  tenantId    String?
  employeeId String
  type       LeaveType
  balance    Float    @default(0)
  year       Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Attendance {
  id         String   @id @default(uuid())
  tenantId    String?
  employeeId String
  date       DateTime @db.Date
  timeIn     DateTime? @db.Timestamptz(6)
  timeOut    DateTime? @db.Timestamptz(6)
  hours      Float?
  remark     String?
  // Provenance: MANUAL | IMPORT | PUNCH | DEVICE. deviceRef is
  // "DEVICE:<deviceId>:<deviceLogId>" for rows written by the biometric sync.
  source     String?  @default("MANUAL")
  deviceRef  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, employeeId, date])
}

model BiometricDevice {
  id             String    @id @default(uuid())
  tenantId       String?
  name           String
  model          String?
  // ZK_TCP = backend pulls via the ZK protocol (port 4370). ADMS push is a
  // planned follow-up for models that push /iclock/cdata HTTP events.
  protocol       String    @default("ZK_TCP")
  host           String
  port           Int       @default(4370)
  serial         String?
  active         Boolean   @default(true)
  pollIntervalMs Int       @default(30000)
  lastConnectedAt DateTime? @db.Timestamptz(6)
  lastSyncAt     DateTime? @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  logs           BiometricDeviceLog[]
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, active])
}

model BiometricDeviceLog {
  id           String   @id @default(uuid())
  tenantId     String?
  deviceId     String
  // Device-side record index. Dedupes repeated pulls (idempotent sync).
  deviceLogId  String
  userId       String
  punchedAt    DateTime @db.Timestamptz(6)
  verification String?
  // Linked Employee id when userId matched an employeeNumber, else null.
  employeeId   String?
  // True when the event created/updated an Attendance row.
  applied      Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  device       BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceLogId])
  @@index([tenantId, deviceId, punchedAt])
}

model Appointment {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  type        AppointmentType
  itemNumber  String
  plantillaItemId String?
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  status      AppointmentStatus @default(PENDING)
  position    String?
  dept        String?
  name        String?
  signedBy    String?
  issuedBy    String?
  approvedBy  String?
  verifiedBy  String?
  documentUrl String?
  oraohraReference String?
  cscFormNo   String?
  remarks     String?
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  plantillaItem PlantillaItem? @relation(fields: [plantillaItemId], references: [id])
  designationOrders DesignationOrder[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model PerformanceReview {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  reviewYear  Int
  reviewType  String
  rating      Float?
  comments    String?
  status      ReviewStatus @default(DRAFT)
  reviewedBy  String?
  reviewedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  competencies PerformanceCompetency[]
}

model PlantillaItem {
  id           String          @id @default(uuid())
  tenantId    String?
  itemNumber   String          @unique
  positionId   String
  departmentId String
  status       PlantillaStatus @default(VACANT)
  itemType     PlantillaItemType @default(OLD_STYLE)
  isMandatory  Boolean @default(false)
  isOptional   Boolean @default(false)
  salaryGrade  String?
  step         String?
  sourceOfFund String?
  appropriationCode String?
  authorizedSalary Decimal? @db.Decimal(12,2)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  position     Position        @relation(fields: [positionId], references: [id])
  department   Department      @relation(fields: [departmentId], references: [id])
  vacancies    Vacancy[]
  appointments Appointment[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Vacancy {
  id              String        @id @default(uuid())
  tenantId        String?
  plantillaItemId String
  title           String
  description     String?
  qualifications  String?
  eligibilityRequirements String?
  screeningCriteria String?
  status          VacancyStatus @default(DRAFT)
  publishedAt     DateTime?     @db.Timestamptz(6)
  approvedBy      String?
  publishedBy     String?
  closesAt        DateTime?     @db.Date
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  plantillaItem   PlantillaItem @relation(fields: [plantillaItemId], references: [id])
  publications     VacancyPublication[]
  designationOrders DesignationOrder[]
  applicants       Applicant[]
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])
}

model VacancyPublication {
  id           String   @id @default(uuid())
  tenantId    String?
  vacancyId    String
  channel      String
  publishedAt  DateTime @default(now()) @db.Timestamptz(6)
  publishedBy  String?
  link         String?
  vacancy      Vacancy  @relation(fields: [vacancyId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model DesignationOrder {
  id            String   @id @default(uuid())
  tenantId    String?
  employeeId    String
  appointmentId String?
  vacancyId     String?
  orderNumber   String   @unique
  issuedDate    DateTime @db.Date
  effectiveDate DateTime? @db.Date
  expirationDate DateTime? @db.Date
  signedBy      String?
  approvedBy    String?
  recommendedBy String?
  status        DesignationStatus @default(DRAFT)
  documentUrl   String?
  remarks       String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  employee      Employee @relation(fields: [employeeId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  vacancy       Vacancy? @relation(fields: [vacancyId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model TrainingProgram {
  id           String   @id @default(uuid())
  tenantId    String?
  code         String   @unique
  title        String
  description  String?
  durationHours Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  enrollments  TrainingEnrollment[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model TrainingEnrollment {
  id         String   @id @default(uuid())
  tenantId    String?
  employeeId String
  programId  String
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
  program    TrainingProgram @relation(fields: [programId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Eligibility {
  id          String   @id @default(uuid())
  tenantId    String?
  employeeId  String
  eligibilityType EligibilityType
  rating      String?
  examDate    DateTime? @db.Date
  validUntil  DateTime? @db.Date
  remarks     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

// DIBAR - Disqualified, Barred, or Disqualified Individuals
enum DisqualificationType {
  VIOLATION_OF_CSC_RULES
  CRIMINAL_CONVICTION
  MORAL_TURPITUDE
  FRAUD
  MISCONDUCT
  OTHER
}

enum DisqualificationReason {
  GROSS_MISCONDUCT
  HARRASSMENT
  EMBEZZLEMENT
  FRAUDULENT_MISREPRESENTATION
  SUBSTANCE_ABUSE
  POLITICAL_PARTISANISM
  OTHER_GROUNDS
}

model Disqualification {
  id                    String           @id @default(uuid())
  tenantId    String?
  employeeId            String
  type                  DisqualificationType
  reason                DisqualificationReason
  date                  DateTime         @db.Date
  validity              DateTime?        @db.Date
  remarks               String?
  evidenceDocument      String?          // URL or path to supporting document
  isBarred              Boolean          @default(false)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  createdBy             String?
  employee              Employee         @relation(fields: [employeeId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Applicant {
  id            String   @id @default(uuid())
  tenantId    String?
  firstName     String
  lastName      String
  middleName    String?
  email         String?
  phone         String?
  status        ApplicantStatus @default(APPLIED)
  vacancyId     String?
  appliedPositionId String?
  appliedDepartmentId String?
  eligibilityScore Int?
  screeningScore Int?
  interviewScore Int?
  selectionBoardNotes String?
  hiredEmployeeId String?
  resumeUrl     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  position      Position? @relation(fields: [appliedPositionId], references: [id])
  department    Department? @relation(fields: [appliedDepartmentId], references: [id])
  vacancy       Vacancy? @relation(fields: [vacancyId], references: [id])
