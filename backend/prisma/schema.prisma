generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  passwordHash     String
  role             Role
  departmentId     String?
  externalId       String?
  passwordChangedAt DateTime? @db.Timestamptz(6)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  displayPrefs     Json?
  avatarPath       String?
  signaturePath    String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  department       Department? @relation(fields: [departmentId], references: [id])
  auditLogs        AuditLog[]
  sessions         UserSession[]
  loginEvents      LoginEvent[]
  delegationsFrom  Delegation[] @relation("delegator")
  delegationsTo    Delegation[] @relation("delegatee")
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  parentId  String?
  level     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  users     User[]
  employees Employee[]
  parent    Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")
}

model Position {
  id          String   @id @default(uuid())
  title       String
  salaryGrade Int
  step        Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employees   Employee[]
}

model Employee {
  id               String   @id @default(uuid())
  employeeNumber   String   @unique
  firstName        String
  lastName         String
  middleName       String?
  birthDate        DateTime @db.Date
  gender           String
  civilStatus      String
  address          String
  contactNumber    String?
  email            String?
  status           EmploymentStatus @default(ACTIVE)
  departmentId     String
  positionId       String
  hiredDate        DateTime @db.Date
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  department       Department @relation(fields: [departmentId], references: [id])
  position         Position @relation(fields: [positionId], references: [id])
  employmentHistory EmploymentHistory[]
  payrollItems     PayrollItem[]
  leaveRequests    LeaveRequest[]
  leaveCredits     LeaveCredit[]
  attendances      Attendance[]
  appointments     Appointment[]
}

model EmploymentHistory {
  id         String   @id @default(uuid())
  employeeId String
  departmentId String
  positionId String
  startDate  DateTime @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model PayrollPeriod {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  fiscalYear Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  runs      PayrollRun[]
}

model PayrollRun {
  id          String   @id @default(uuid())
  periodId    String
  runDate     DateTime @db.Date
  status      PayrollStatus @default(DRAFT)
  createdBy   String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  period      PayrollPeriod @relation(fields: [periodId], references: [id])
  items       PayrollItem[]
  ledgerEntries LedgerEntry[]
}

model PayrollItem {
  id          String   @id @default(uuid())
  employeeId  String
  runId       String
  basicPay    Decimal  @db.Decimal(12,2)
  allowances  Decimal  @db.Decimal(12,2)
  deductions  Decimal  @db.Decimal(12,2)
  netPay      Decimal  @db.Decimal(12,2)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
  run         PayrollRun @relation(fields: [runId], references: [id])
}

model LedgerEntry {
  id        String   @id @default(uuid())
  runId     String
  employeeId String
  type      LedgerType
  amount    Decimal  @db.Decimal(12,2)
  balance   Decimal  @db.Decimal(12,2)
  reference String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  run       PayrollRun @relation(fields: [runId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  user      User @relation(fields: [userId], references: [id])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  deviceHash String
  ip         String?
  userAgent  String?
  lastActive DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Delegation {
  id         String   @id @default(uuid())
  delegatorId String
  delegateeId String
  scope      String?
  reason     String?
  startsAt   DateTime @db.Timestamptz(6)
  endsAt     DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  delegator  User     @relation("delegator", fields: [delegatorId], references: [id])
  delegatee  User     @relation("delegatee", fields: [delegateeId], references: [id])
}

model LeaveRequest {
  id          String   @id @default(uuid())
  employeeId  String
  type        LeaveType
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  days        Float
  status      LeaveStatus @default(PENDING)
  reason      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
}

model LeaveCredit {
  id         String   @id @default(uuid())
  employeeId String
  type       LeaveType
  balance    Float    @default(0)
  year       Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime @db.Date
  timeIn     DateTime? @db.Timestamptz(6)
  timeOut    DateTime? @db.Timestamptz(6)
  hours      Float?
  remark     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Appointment {
  id          String   @id @default(uuid())
  employeeId  String
  type        AppointmentType
  itemNumber  String
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  status      String @default("ACTIVE")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  employee    Employee @relation(fields: [employeeId], references: [id])
}

enum Role {
  ADMIN
  HR_MANAGER
  PAYROLL_OFFICER
  DEPARTMENT_HEAD
  AUDITOR
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  RETIRED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  POSTED
}

enum LedgerType {
  PAY
  DEDUCTION
  ADJUSTMENT
}

enum LeaveType {
  VACATION
  SICK
  SPECIAL_PRIVILEGE
  MATERNITY
  PATERNITY
  SOLO_PARENT
  SPECIAL_WOMEN
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum AppointmentType {
  PERMANENT
  TEMPORARY
  CASUAL
  CONTRACTUAL
  JOB_ORDER
  COS
  COTERMINOUS
}
