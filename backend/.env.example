DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lgu_hrms?schema=public"
# ── Production: generate fresh values, never commit ──────────────────────
#   JWT_SECRET:            openssl rand -hex 32
#   JWT_REFRESH_SECRET:    openssl rand -hex 32
#   POSTGRES_PASSWORD:     openssl rand -hex 24
#   WEB_ORIGIN:            https://hrms.your-lgu.gov.ph
#   VITE_API_BASE:         /api/v1  (same-origin via nginx proxy)
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="lgu_hrms"
WEB_ORIGIN="http://localhost"
VITE_API_BASE="/api/v1"
WEB_PORT="80"
SEED_DEFAULT_PASSWORD="change-me"
PORT=4000
NODE_ENV=development
# On-premise login enforcement. Comma-separated global CIDR fallback used when
# a tenant's own `allowedIps` is empty. Leave empty to allow from anywhere.
ALLOWED_IPS=""
# Real client IPs behind a proxy: "1" (trust first hop / nginx) or a subnet
# list e.g. "loopback, 10.0.0.0/8". Required for the allowlist to see callers.
TRUST_PROXY="1"
# Per-tenant on-premise lists are configured on the platform Tenant page.
# Shared secret that kiosks must send as `punchKey` to the PUBLIC punch
# endpoint. Leave unset to keep the endpoint open (any authenticated-less
# caller can punch by employeeNumber).
BIOMETRIC_PUNCH_KEY=""
# Biometric terminal sync. Set to 1 to start the poller loop that pulls ZK
# attendance logs from active BiometricDevice rows every BIOMETRIC_POLL_MS
# (default 30000). Requires a reachable device on the LAN (port 4370).
BIOMETRIC_POLLER="0"
BIOMETRIC_POLL_MS="30000"
# Sentry error tracking (optional). Leave unset to disable; SDK no-ops without it.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="1.0"
